{
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path_lookup": true
      },
      "initialization_options": {
        "check": {
          "command": "clippy"
        },
        "cargo": {
          "allTargets": true
        },
        "procMacro": {
          "enable": true
        },
        "diagnostics": {
          "enable": true,
          "disabled": ["inactive-code"]
        }
      }
    }
  }
}
